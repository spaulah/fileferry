{
  "name": "fileferry-monorepo",
  "description": "Monorepo for fileferry: reliable external sharing of folders and files.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "check": "npm run build && npm run typecheck && npm run lint && npm test && npm run check:packages",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "check:packages": "publint packages/core && publint packages/fake-graph && publint packages/fake-dropbox"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "publint": "^0.3.25",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.3.8"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spaulah/fileferry.git"
  },
  "homepage": "https://github.com/spaulah/fileferry#readme",
  "bugs": {
    "url": "https://github.com/spaulah/fileferry/issues"
  }
}
