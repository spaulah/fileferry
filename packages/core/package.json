{
  "name": "@fileferry/core",
  "version": "0.1.1",
  "description": "Framework-free engine for sharing folders and files with external people, on SharePoint, OneDrive and Dropbox.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fileferry/fake-dropbox": "0.1.0",
    "@fileferry/fake-graph": "0.1.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.8.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "sharing",
    "external-sharing",
    "sharepoint",
    "onedrive",
    "dropbox",
    "microsoft-graph",
    "file-sharing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spaulah/fileferry.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/spaulah/fileferry#readme",
  "bugs": {
    "url": "https://github.com/spaulah/fileferry/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
